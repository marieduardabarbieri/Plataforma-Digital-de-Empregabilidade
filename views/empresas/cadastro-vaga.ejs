<!DOCTYPE html>
<html>
  <head>
    <title>Cadastrar vaga - VagaCerta</title>

    <link rel="stylesheet" href="/stylesheets/style.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <link rel="shortcut icon" type="imagex/png" href="/images/icon.png" />
  </head>

  <body>
    <%- include('../partials/header') %>

    <main class="login-page">
      <section class="login-card">
        <h1>Cadastrar nova vaga</h1>

        <p class="section-text">
          Preencha os dados da vaga para encontrar os candidatos ideais.
        </p>

        <form class="login-form" action="/vagas/cadastrar" method="POST">
          <div class="login-field">
            <label for="titulo_vaga">Título da vaga</label>

            <div class="search-field">
              <i class="fa-solid fa-briefcase"></i>

              <input
                class="form-input"
                type="text"
                id="titulo_vaga"
                name="titulo_vaga"
                placeholder="Ex.: Analista de Dados..."
                required
              />
            </div>
          </div>

          <div class="login-field">
            <label for="quantidade_vagas">Quantidade de vagas</label>

            <div class="search-field">
              <i class="fa-solid fa-users"></i>

              <input
                class="form-input"
                type="number"
                id="quantidade_vagas"
                name="quantidade_vagas"
                placeholder="Ex.: 2"
                min="1"
                required
              />
            </div>
          </div>

          <div class="login-field">
            <label for="salario">Salário</label>

            <div class="search-field">
              <i class="fa-solid fa-money-bill"></i>

              <input
                class="form-input"
                type="number"
                id="salario"
                name="salario"
                placeholder="Ex.: 2500"
                min="0"
                step="0.01"
                required
              />
            </div>
          </div>

          <div class="login-field">
            <label for="regime_contrato">Regime de contrato</label>

            <div class="search-field">
              <i class="fa-solid fa-file-contract"></i>

              <input
                class="form-input"
                type="text"
                id="regime_contrato"
                name="regime_contrato"
                placeholder="Ex.: CLT, Estágio, PJ..."
                required
              />
            </div>
          </div>

          <div class="login-field">
            <label for="tipo_trabalho">Tipo de trabalho</label>

            <div class="search-field">
              <i class="fa-solid fa-building"></i>

              <input
                class="form-input"
                type="text"
                id="tipo_trabalho"
                name="tipo_trabalho"
                placeholder="Ex.: Desenvolvedor, Auxiliar..."
                required
              />
            </div>
          </div>

          <div class="login-field">
            <label for="localizacao">Localização</label>

            <div class="search-field">
              <i class="fa-solid fa-location-dot"></i>

              <input
                class="form-input"
                type="text"
                id="localizacao"
                name="localizacao"
                placeholder="Ex.: São Paulo - SP"
                required
              />
            </div>
          </div>

          <div class="login-field">
            <label for="descricao_vaga">Descrição da vaga</label>

            <div class="search-field descricao-field">
              <i class="fa-solid fa-align-left"></i>

              <textarea
                class="form-input descricao-input"
                id="descricao_vaga"
                name="descricao_vaga"
                placeholder="Descreva as atividades, requisitos e informações da vaga..."
                rows="5"
                required
              ></textarea>
            </div>
          </div>

          <button type="submit" class="btn-register" id="cadastro-button">
            Cadastrar vaga
          </button>
        </form>
      </section>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
