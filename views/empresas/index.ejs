<!DOCTYPE html>
<html>

<head>
    <title>Titulo da Página</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
    <body>

        <%-include('../partials/header') %>

        <% empresas.forEach((empresa)=> { %>
            <h1><%= empresa.nome_empresa %></h1> 
           <p>Cnpj: <%= empresa.cnpj %> </p>
           <p>Email: <%= empresa.email %> </p>
           <p>Telefone: <%= empresa.telefone %> </p>
           <p>Area de atuação <%= empresa.area_atuacao %> </p>
           <p>Perfil: <%= empresa.perfil %> </p>
           <p>Cidade: <%= empresa.cidade %></p>
           <p>UF: <%= empresa.uf %> </p>
           <p>Localização <%= empresa.localizacao %></p>
           <p>Descrição <%= empresa.descricao %></p>

            <h3> Vagas da Empresa</h3>
            <% empresa.vagas.forEach((vaga) => { %>
              <p>Vaga de:   <%=vaga.titulo_vaga %></p>
            <% }) %>
        <% }) %>

        <%-include('../partials/footer') %>
    </body>
</html>