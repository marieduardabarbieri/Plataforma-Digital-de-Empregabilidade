<!DOCTYPE html>
<html>

<head>
    <title>Titulo da Página</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
    <body>

        <%-include('../partials/header') %>

        <% empresas.forEach((empresa)=> { %>
            <h1><%= empresa.nome_empresa %></h1> 
            <%= empresa.cnpj %> 
            <%= empresa.email %> 
            <%= empresa.telefone %> 
            <%= empresa.area_atuacao %> 
            <%= empresa.perfil %> 
            <%= empresa.cidade %>
            <%= empresa.uf %> 
            <%= empresa.localizacao %>
            <%= empresa.descricao %>

            <h3> Estágios da Empresa</h3>
            <% empresa.vagas.forEach((vaga) => { %>
                <%=vaga.titulo_vaga %>
            <% }) %>
        <% }) %>

        <%-include('../partials/footer') %>
    </body>
</html>