<!DOCTYPE html>
<html>
  <head>
    <title>Cadastro de Empresa - VagaCerta</title>

    <link rel="stylesheet" href="/stylesheets/style.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <link rel="shortcut icon" type="imagex/png" href="/images/icon.png" />
  </head>

  <body>
    <%- include('../partials/header') %>
    <main class="login-page">
      <section class="login-card cadastro-empresa-card">
        <div class="cadastro-topo">
          <span class="cadastro-tag">
            <i class="fa-solid fa-building"></i>
            Cadastro empresarial
          </span>

          <h1>Crie sua conta</h1>

          <p class="section-text">
            Cadastre sua empresa para encontrar profissionais e divulgar suas
            oportunidades.
          </p>
        </div>

        <form class="login-form empresa">
          <!-- DADOS DA EMPRESA -->
          <div class="cadastro-secao">
            <div class="cadastro-secao-titulo">
              <i class="fa-solid fa-building"></i>
              <div>
                <h2>Dados da empresa</h2>
                <span>Informe os dados principais da sua empresa.</span>
              </div>
            </div>

            <div class="cadastro-grid">
              <!-- NOME -->
              <div class="login-field campo-largo">
                <label for="nome_empresa">Nome da empresa</label>

                <div class="search-field">
                  <i class="fa-solid fa-building"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="nome_empresa"
                    name="nome_empresa"
                    placeholder="Digite o nome da empresa..."
                    required
                  />
                </div>
              </div>

              <!-- CNPJ -->
              <div class="login-field">
                <label for="cnpj">CNPJ</label>

                <div class="search-field">
                  <i class="fa-solid fa-id-card"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="cnpj"
                    name="cnpj"
                    placeholder="Digite o CNPJ..."
                    required
                  />
                </div>
              </div>

              <!-- EMAIL -->
              <div class="login-field">
                <label for="email">E-mail</label>

                <div class="search-field">
                  <i class="fa-solid fa-envelope"></i>

                  <input
                    class="form-input"
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Digite o e-mail da empresa..."
                    required
                  />
                </div>
              </div>

              <!-- SENHA -->
              <div class="login-field">
                <label for="senha">Senha</label>

                <div class="search-field">
                  <i class="fa-solid fa-lock"></i>

                  <input
                    class="form-input"
                    type="password"
                    id="senha"
                    name="senha"
                    placeholder="Crie uma senha..."
                    required
                  />
                </div>
              </div>

              <!-- TELEFONE -->
              <div class="login-field">
                <label for="telefone">Telefone</label>

                <div class="search-field">
                  <i class="fa-solid fa-phone"></i>

                  <input
                    class="form-input"
                    type="tel"
                    id="telefone"
                    name="telefone"
                    placeholder="Digite o telefone..."
                    required
                  />
                </div>
              </div>

              <!-- ÁREA DE ATUAÇÃO -->
              <div class="login-field">
                <label for="area_atuacao">Área de atuação</label>

                <div class="search-field">
                  <i class="fa-solid fa-briefcase"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="area_atuacao"
                    name="area_atuacao"
                    placeholder="Ex.: Tecnologia, Saúde..."
                    required
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- LOCALIZAÇÃO -->
          <div class="cadastro-secao">
            <div class="cadastro-secao-titulo">
              <i class="fa-solid fa-location-dot"></i>
              <div>
                <h2>Localização</h2>
                <span>Informe a cidade onde sua empresa está localizada.</span>
              </div>
            </div>

            <div class="cadastro-grid">
              <!-- CIDADE -->
              <div class="login-field">
                <label for="cidade">Cidade</label>

                <div class="search-field">
                  <i class="fa-solid fa-location-dot"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="cidade"
                    name="cidade"
                    placeholder="Digite a cidade..."
                    required
                  />
                </div>
              </div>

              <!-- UF -->
              <div class="login-field">
                <label for="uf">Estado (UF)</label>

                <div class="search-field">
                  <i class="fa-solid fa-map"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="uf"
                    name="uf"
                    maxlength="2"
                    placeholder="Ex.: MS"
                    required
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- PERFIL: mantém o atributo sem aparecer para o usuário -->
          <input type="hidden" name="perfil" value="empresa" />

          <!-- BOTÃO -->
          <button type="submit" class="btn-register" id="cadastro-button">
            <i class="fa-solid fa-arrow-right"></i>
            Continuar cadastro
          </button>

          <hr class="linha" />

          <span class="hero-info cadastro-seguranca">
            <i class="fa-solid fa-shield-halved"></i>
            Seus dados serão armazenados de forma segura.
          </span>
        </form>
      </section>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
