<!DOCTYPE html>
<html>
  <head>
    <title>Cadastro de Empresa - VagaCerta</title>

    <link rel="stylesheet" href="/stylesheets/style.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <link rel="shortcut icon" type="imagex/png" href="/images/icon.png" />
  </head>

  <body>
    <%- include('../partials/header') %>

    <main class="login-page">
      <section class="login-card cadastro-empresa-card">
        <h1>Criar conta</h1>

        <p class="section-text">
          Cadastre sua empresa e encontre os melhores talentos.
        </p>

        <form class="login-form empresa">
          <!-- NOME DA EMPRESA -->
          <div class="login-field">
            <label for="nome_empresa">Nome da empresa</label>

            <div class="search-field">
              <i class="fa-solid fa-building"></i>

              <input
                class="form-input"
                type="text"
                id="nome_empresa"
                name="nome_empresa"
                placeholder="Digite o nome da empresa..."
                required
              />
            </div>
          </div>

          <!-- CNPJ -->
          <div class="login-field">
            <label for="cnpj">CNPJ</label>

            <div class="search-field">
              <i class="fa-solid fa-id-card"></i>

              <input
                class="form-input"
                type="text"
                id="cnpj"
                name="cnpj"
                placeholder="Digite o CNPJ..."
                required
              />
            </div>
          </div>

          <!-- EMAIL -->
          <div class="login-field">
            <label for="email">Email</label>

            <div class="search-field">
              <i class="fa-solid fa-envelope"></i>

              <input
                class="form-input"
                type="email"
                id="email"
                name="email"
                placeholder="Digite o e-mail da empresa..."
                required
              />
            </div>
          </div>

          <!-- SENHA -->
          <div class="login-field">
            <label for="senha">Senha</label>

            <div class="search-field">
              <i class="fa-solid fa-lock"></i>

              <input
                class="form-input"
                type="password"
                id="senha"
                name="senha"
                placeholder="Digite sua senha..."
                required
              />
            </div>
          </div>

          <!-- TELEFONE -->
          <div class="login-field">
            <label for="telefone">Telefone</label>

            <div class="search-field">
              <i class="fa-solid fa-phone"></i>

              <input
                class="form-input"
                type="tel"
                id="telefone"
                name="telefone"
                placeholder="Digite o telefone..."
                required
              />
            </div>
          </div>

          <!-- ÁREA DE ATUAÇÃO -->
          <div class="login-field">
            <label for="area_atuacao">Área de atuação</label>

            <div class="search-field">
              <i class="fa-solid fa-briefcase"></i>

              <input
                class="form-input"
                type="text"
                id="area_atuacao"
                name="area_atuacao"
                placeholder="Ex.: Tecnologia, Saúde..."
                required
              />
            </div>
          </div>

          <div class="localizacao">
            <i class="fa-solid fa-map-pin"></i>
            <p class="section-text">Localização</p>
          </div>

          <!-- CIDADE -->
          <div class="login-field">
            <label for="cidade">Cidade</label>

            <div class="search-field">
              <i class="fa-solid fa-location-dot"></i>

              <input
                class="form-input"
                type="text"
                id="cidade"
                name="cidade"
                placeholder="Digite a cidade..."
                required
              />
            </div>
          </div>

          <!-- UF -->
          <div class="login-field">
            <label for="uf">Estado (UF)</label>

            <div class="search-field">
              <i class="fa-solid fa-map"></i>

              <input
                class="form-input"
                type="text"
                id="uf"
                name="uf"
                maxlength="2"
                placeholder="Ex.: SP"
                required
              />
            </div>
          </div>

          <!-- RUA -->
          <div class="login-field">
            <label for="rua">Rua</label>

            <div class="search-field">
              <i class="fa-solid fa-road"></i>

              <input
                class="form-input"
                type="text"
                id="rua"
                name="rua"
                placeholder="Digite o nome da rua..."
                required
              />
            </div>
          </div>

          <!-- NÚMERO -->
          <div class="login-field">
            <label for="numero">Número</label>

            <div class="search-field">
              <i class="fa-solid fa-hashtag"></i>

              <input
                class="form-input"
                type="text"
                id="numero"
                name="numero"
                placeholder="Ex.: 123"
                required
              />
            </div>
          </div>

          <!-- BAIRRO -->
          <div class="login-field">
            <label for="bairro">Bairro</label>

            <div class="search-field">
              <i class="fa-solid fa-map-pin"></i>

              <input
                class="form-input"
                type="text"
                id="bairro"
                name="bairro"
                placeholder="Digite o bairro..."
                required
              />
            </div>
          </div>

          <!-- COMPLEMENTO -->
          <div class="login-field">
            <label for="complemento">Complemento</label>

            <div class="search-field">
              <i class="fa-solid fa-location-arrow"></i>

              <input
                class="form-input"
                type="text"
                id="complemento"
                name="complemento"
                placeholder="Ex.: Sala 201, Bloco A..."
              />
            </div>
          </div>

          <!-- CEP -->
          <div class="login-field">
            <label for="cep">CEP</label>

            <div class="search-field">
              <i class="fa-solid fa-envelopes-bulk"></i>

              <input
                class="form-input"
                type="text"
                id="cep"
                name="cep"
                maxlength="9"
                placeholder="Ex.: 01001-000"
                required
              />
            </div>
          </div>

          <div class="localizacao">
            <i class="fa-solid fa-building iconeverde"></i>
            <p class="section-text">Sobre a empresa</p>
          </div>

          <!-- LINK EMPRESA -->
          <div class="login-field">
            <label for="cep">Link da Empresa (Opcional)</label>

            <div class="search-field">
              <i class="fa-solid fa-envelopes-bulk"></i>

              <input
                class="form-input"
                type="text"
                id="link_empresa"
                name="link_empresa"
                placeholder="Ex.: www.gogle.com"
              />
            </div>
          </div>

          <!-- DESCRIÇÃO -->
          <div class="login-field">
            <label for="descricao">Descrição da empresa</label>

            <div class="search-field descricao-field">
              <i class="fa-solid fa-align-left"></i>

              <textarea
                class="form-input descricao-input"
                id="descricao"
                name="descricao"
                placeholder="Conte um pouco sobre sua empresa..."
                rows="4"
                required
              ></textarea>
            </div>
          </div>

          <!-- PERFIL -->
          <div class="login-field">
            <label>Perfil</label>

            <div class="perfil-radio">
              <label>
                <input type="radio" name="perfil" value="empresa" checked />

                Empresa
              </label>
            </div>
          </div>

          <!-- BOTÃO -->
          <button type="submit" class="btn-register" id="cadastro-button">
            Criar conta
          </button>

          <hr class="linha" />

          <span class="hero-info" style="text-align: center">
            Seus dados serão armazenados de forma segura.
          </span>
        </form>
      </section>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
