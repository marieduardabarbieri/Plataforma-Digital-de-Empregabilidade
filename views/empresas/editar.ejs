<!DOCTYPE html>
<html>
  <head>
    <title>Editar perfil - VagaCerta</title>

    <link rel="stylesheet" href="/stylesheets/style.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <link rel="shortcut icon" type="imagex/png" href="/images/icon.png" />
  </head>

  <body>
    <%- include('../partials/header-empresa') %>

    <main class="login-page">
      <section class="login-card cadastro-empresa-card">
        <div class="cadastro-topo">
          <span class="cadastro-tag">
            <i class="fa-solid fa-building"></i>
            Perfil empresarial
          </span>

          <h1>Editar perfil</h1>

          <p class="section-text">
            Atualize as informações da sua empresa e mantenha seu perfil
            completo.
          </p>
        </div>

        <form class="login-form empresa">
          <!-- DADOS DA EMPRESA -->
          <div class="cadastro-secao">
            <div class="cadastro-secao-titulo">
              <i class="fa-solid fa-building"></i>

              <div>
                <h2>Dados da empresa</h2>
                <span>Informações principais da sua empresa.</span>
              </div>
            </div>

            <div class="cadastro-grid">
              <!-- NOME -->
              <div class="login-field campo-largo">
                <label for="nome_empresa">Nome da empresa</label>

                <div class="search-field">
                  <i class="fa-solid fa-building"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="nome_empresa"
                    name="nome_empresa"
                    placeholder="Digite o nome da empresa..."
                  />
                </div>
              </div>

              <!-- CNPJ -->
              <div class="login-field">
                <label for="cnpj">CNPJ</label>

                <div class="search-field">
                  <i class="fa-solid fa-id-card"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="cnpj"
                    name="cnpj"
                    placeholder="Digite o CNPJ..."
                  />
                </div>
              </div>

              <!-- EMAIL -->
              <div class="login-field">
                <label for="email">E-mail</label>

                <div class="search-field">
                  <i class="fa-solid fa-envelope"></i>

                  <input
                    class="form-input"
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Digite o e-mail..."
                  />
                </div>
              </div>

              <!-- SENHA -->
              <div class="login-field">
                <label for="senha">Nova senha</label>
                <small class="campo-ajuda">
                  Deixe em branco para manter sua senha atual.
                </small>
                <div class="search-field">
                  <i class="fa-solid fa-lock"></i>

                  <input
                    class="form-input"
                    type="password"
                    id="senha"
                    name="senha"
                    placeholder="Digite uma nova senha..."
                  />
                </div>
              </div>

              <!-- TELEFONE -->
              <div class="login-field">
                <label for="telefone">Telefone</label>

                <div class="search-field">
                  <i class="fa-solid fa-phone"></i>

                  <input
                    class="form-input"
                    type="tel"
                    id="telefone"
                    name="telefone"
                    placeholder="Digite o telefone..."
                  />
                </div>
              </div>

              <!-- ÁREA DE ATUAÇÃO -->
              <div class="login-field">
                <label for="area_atuacao">Área de atuação</label>

                <div class="search-field">
                  <i class="fa-solid fa-briefcase"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="area_atuacao"
                    name="area_atuacao"
                    placeholder="Ex.: Tecnologia, Saúde..."
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- ENDEREÇO -->
          <div class="cadastro-secao">
            <div class="cadastro-secao-titulo">
              <i class="fa-solid fa-location-dot"></i>

              <div>
                <h2>Endereço</h2>
                <span>Informe a localização da sua empresa.</span>
              </div>
            </div>

            <div class="cadastro-grid">
              <!-- CIDADE -->
              <div class="login-field">
                <label for="cidade">Cidade</label>

                <div class="search-field">
                  <i class="fa-solid fa-location-dot"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="cidade"
                    name="cidade"
                    placeholder="Digite a cidade..."
                  />
                </div>
              </div>

              <!-- UF -->
              <div class="login-field">
                <label for="uf">Estado (UF)</label>

                <div class="search-field">
                  <i class="fa-solid fa-map"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="uf"
                    name="uf"
                    maxlength="2"
                    placeholder="Ex.: MS"
                  />
                </div>
              </div>

              <!-- RUA -->
              <div class="login-field">
                <label for="rua">Rua</label>

                <div class="search-field">
                  <i class="fa-solid fa-road"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="rua"
                    name="rua"
                    placeholder="Digite o nome da rua..."
                  />
                </div>
              </div>

              <!-- NÚMERO -->
              <div class="login-field">
                <label for="numero">Número</label>

                <div class="search-field">
                  <i class="fa-solid fa-hashtag"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="numero"
                    name="numero"
                    placeholder="Ex.: 123"
                  />
                </div>
              </div>

              <!-- BAIRRO -->
              <div class="login-field">
                <label for="bairro">Bairro</label>

                <div class="search-field">
                  <i class="fa-solid fa-map-pin"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="bairro"
                    name="bairro"
                    placeholder="Digite o bairro..."
                  />
                </div>
              </div>

              <!-- COMPLEMENTO -->
              <div class="login-field">
                <label for="complemento">Complemento</label>

                <div class="search-field">
                  <i class="fa-solid fa-location-arrow"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="complemento"
                    name="complemento"
                    placeholder="Ex.: Sala 201, Bloco A..."
                  />
                </div>
              </div>

              <!-- CEP -->
              <div class="login-field">
                <label for="cep">CEP</label>

                <div class="search-field">
                  <i class="fa-solid fa-envelopes-bulk"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="cep"
                    name="cep"
                    maxlength="9"
                    placeholder="Ex.: 79750-000"
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- SOBRE A EMPRESA -->
          <div class="cadastro-secao">
            <div class="cadastro-secao-titulo">
              <i class="fa-solid fa-circle-info"></i>

              <div>
                <h2>Sobre a empresa</h2>
                <span>Apresente sua empresa aos candidatos.</span>
              </div>
            </div>

            <div class="cadastro-grid">
              <!-- LINK -->
              <div class="login-field campo-largo">
                <label for="link_empresa">Site ou link da empresa</label>

                <div class="search-field">
                  <i class="fa-solid fa-link"></i>

                  <input
                    class="form-input"
                    type="url"
                    id="link_empresa"
                    name="link_empresa"
                    placeholder="Ex.: https://www.suaempresa.com.br"
                  />
                </div>
              </div>

              <!-- DESCRIÇÃO -->
              <div class="login-field campo-largo">
                <label for="descricao">Descrição da empresa</label>

                <div class="search-field descricao-field">
                  <i class="fa-solid fa-align-left"></i>

                  <textarea
                    class="form-input descricao-input"
                    id="descricao"
                    name="descricao"
                    placeholder="Conte um pouco sobre sua empresa..."
                    rows="5"
                  ></textarea>
                </div>
              </div>
            </div>
          </div>

          <!-- BOTÃO -->
          <button type="submit" class="btn-register" id="cadastro-button">
            <i class="fa-solid fa-check"></i>
            Salvar alterações
          </button>
        </form>
      </section>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
