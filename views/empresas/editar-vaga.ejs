<!DOCTYPE html>
<html>
  <head>
    <title>Editar vaga - VagaCerta</title>

    <link rel="stylesheet" href="/stylesheets/style.css" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <link rel="shortcut icon" type="imagex/png" href="/images/icon.png" />
  </head>

  <body>
    <%- include('../partials/header-empresa') %>

    <main class="login-page">
      <section class="login-card cadastro-vaga-card">
        <!-- TOPO -->
        <div class="cadastro-topo">
          <span class="cadastro-tag">
            <i class="fa-solid fa-briefcase"></i>
            Gerenciamento de vaga
          </span>

          <h1>Editar vaga</h1>

          <p class="section-text">
            Atualize as informações e o status desta oportunidade.
          </p>
        </div>

        <form
          class="login-form vaga-form"
          action="/vagas/<%= vaga.id %>/editar"
          method="POST"
        >
          <!-- INFORMAÇÕES DA VAGA -->
          <div class="cadastro-secao">
            <div class="cadastro-secao-titulo">
              <i class="fa-solid fa-briefcase"></i>

              <div>
                <h2>Informações da vaga</h2>
                <span>Atualize os principais dados da oportunidade.</span>
              </div>
            </div>

            <div class="cadastro-grid">
              <!-- TÍTULO -->
              <div class="login-field campo-largo">
                <label for="titulo_vaga">Título da vaga</label>

                <div class="search-field">
                  <i class="fa-solid fa-briefcase"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="titulo_vaga"
                    name="titulo_vaga"
                    value="<%= vaga.titulo_vaga %>"
                    placeholder="Ex.: Analista de Dados..."
                    required
                  />
                </div>
              </div>

              <!-- QUANTIDADE -->
              <div class="login-field">
                <label for="quantidade_vagas"> Quantidade de vagas </label>

                <div class="search-field">
                  <i class="fa-solid fa-users"></i>

                  <input
                    class="form-input"
                    type="number"
                    id="quantidade_vagas"
                    name="quantidade_vagas"
                    value="<%= vaga.quantidade_vagas %>"
                    min="1"
                    required
                  />
                </div>
              </div>

              <!-- SALÁRIO -->
              <div class="login-field">
                <label for="salario">Salário</label>

                <div class="search-field">
                  <i class="fa-solid fa-money-bill"></i>

                  <input
                    class="form-input"
                    type="number"
                    id="salario"
                    name="salario"
                    value="<%= vaga.salario %>"
                    min="0"
                    step="0.01"
                    required
                  />
                </div>
              </div>

              <!-- REGIME -->
              <div class="login-field">
                <label for="regime_contrato"> Regime de contrato </label>

                <div class="search-field">
                  <i class="fa-solid fa-file-contract"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="regime_contrato"
                    name="regime_contrato"
                    value="<%= vaga.regime_contrato %>"
                    placeholder="Ex.: CLT, Estágio, PJ..."
                    required
                  />
                </div>
              </div>

              <!-- TIPO DE TRABALHO -->
              <div class="login-field">
                <label for="tipo_trabalho"> Tipo de trabalho </label>

                <div class="search-field">
                  <i class="fa-solid fa-building"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="tipo_trabalho"
                    name="tipo_trabalho"
                    value="<%= vaga.tipo_trabalho %>"
                    placeholder="Ex.: Presencial, Híbrido..."
                    required
                  />
                </div>
              </div>

              <!-- LOCALIZAÇÃO -->
              <div class="login-field campo-largo">
                <label for="localizacao">Localização</label>

                <div class="search-field">
                  <i class="fa-solid fa-location-dot"></i>

                  <input
                    class="form-input"
                    type="text"
                    id="localizacao"
                    name="localizacao"
                    value="<%= vaga.localizacao %>"
                    placeholder="Ex.: Nova Andradina - MS"
                    required
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- PERÍODO -->
          <div class="cadastro-secao">
            <div class="cadastro-secao-titulo">
              <i class="fa-regular fa-calendar"></i>

              <div>
                <h2>Período de candidatura</h2>
                <span>
                  Defina o período em que os candidatos poderão se candidatar.
                </span>
              </div>
            </div>

            <div class="cadastro-grid">
              <!-- DATA INICIAL -->
              <div class="login-field">
                <label for="data_inicio_candidatura">
                  Início das candidaturas
                </label>

                <div class="search-field">
                  <i class="fa-regular fa-calendar"></i>

                  <input
                    class="form-input"
                    type="date"
                    id="data_inicio_candidatura"
                    name="data_inicio_candidatura"
                    value="<%= vaga.data_inicio_candidatura %>"
                    required
                  />
                </div>
              </div>

              <!-- DATA FINAL -->
              <div class="login-field">
                <label for="data_fim_candidatura"> Fim das candidaturas </label>

                <div class="search-field">
                  <i class="fa-regular fa-calendar-check"></i>

                  <input
                    class="form-input"
                    type="date"
                    id="data_fim_candidatura"
                    name="data_fim_candidatura"
                    value="<%= vaga.data_fim_candidatura %>"
                    required
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- DETALHES DA VAGA -->
          <div class="cadastro-secao">
            <div class="cadastro-secao-titulo">
              <i class="fa-solid fa-list-check"></i>

              <div>
                <h2>Detalhes da vaga</h2>
                <span> Atualize os requisitos, benefícios e descrição. </span>
              </div>
            </div>

            <div class="cadastro-grid">
              <!-- REQUISITOS -->
              <div class="login-field campo-texto">
                <label for="requisitos_vaga"> Requisitos </label>

                <div class="search-field descricao-field">
                  <i class="fa-solid fa-list-check"></i>

                  <textarea
                    class="form-input descricao-input"
                    id="requisitos_vaga"
                    name="requisitos_vaga"
                    placeholder="Ex.: Ensino médio completo..."
                    rows="5"
                    required
                  >
<%= vaga.requisitos_vaga %></textarea
                  >
                </div>
              </div>

              <!-- INFORMAÇÕES ADICIONAIS -->
              <div class="login-field campo-texto">
                <label for="informacoes_adicionais">
                  Informações adicionais
                </label>

                <div class="search-field descricao-field">
                  <i class="fa-solid fa-gift"></i>

                  <textarea
                    class="form-input descricao-input"
                    id="informacoes_adicionais"
                    name="informacoes_adicionais"
                    placeholder="Ex.: Vale-transporte, auxílio alimentação..."
                    rows="5"
                    required
                  >
<%= vaga.informacoes_adicionais %></textarea
                  >
                </div>
              </div>

              <!-- DESCRIÇÃO -->
              <div class="login-field campo-largo">
                <label for="descricao_vaga"> Descrição da vaga </label>

                <div class="search-field descricao-field">
                  <i class="fa-solid fa-align-left"></i>

                  <textarea
                    class="form-input descricao-input"
                    id="descricao_vaga"
                    name="descricao_vaga"
                    placeholder="Descreva as atividades e responsabilidades da vaga..."
                    rows="6"
                    required
                  >
<%= vaga.descricao_vaga %></textarea
                  >
                </div>
              </div>
            </div>
          </div>

          <!-- STATUS DA VAGA -->
          <div class="cadastro-secao">
            <div class="cadastro-secao-titulo">
              <i class="fa-solid fa-toggle-on"></i>

              <div>
                <h2>Status da vaga</h2>
                <span> Defina a situação atual desta oportunidade. </span>
              </div>
            </div>

            <div class="status-vaga-opcoes">
              <label class="status-vaga-option">
                <input
                  type="radio"
                  name="status_vaga"
                  value="Em andamento"
                  checked
                />
                <span> Em andamento </span>
              </label>

              <label class="status-vaga-option">
                <input type="radio" name="status_vaga" value="Encerrada" />
                <span> Encerrada </span>
              </label>

              <label class="status-vaga-option">
                <input type="radio" name="status_vaga" value="Cancelada" />
                <span> Cancelada </span>
              </label>
            </div>
          </div>

          <!-- BOTÃO -->
          <button type="submit" class="btn-register" id="cadastro-button">
            <i class="fa-solid fa-check"></i>
            Salvar alterações
          </button>
        </form>
      </section>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
