<!DOCTYPE html>
<html>

<head>
    <title>Titulo da Página</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <%-include('../partials/header') %>

        <%vagas.forEach((vaga)=> { %>
           <p>Vaga: <%=vaga.titulo_vaga %> <br /></p>
           <p>Quantidade de vagas: <%=vaga.quantidade_vagas %> <br /></p>
           <p>Salário: <%=vaga.salario %> <br /></p>
           <p>Regime do contrato: <%=vaga.regime_contrato %> <br /></p>
           <p>Tipo de trabalho <%=vaga.tipo_trabalho %> <br /></p>
           <p>Localização: <%=vaga.localizacao %> <br /></p>
           <p>Descrição da vaga <%=vaga.descricao_vaga %> <br /></p>
        <% }) %>

    <%-include('../partials/footer') %>
</body>

</html>