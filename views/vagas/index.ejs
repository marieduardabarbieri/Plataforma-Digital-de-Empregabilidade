<!DOCTYPE html>
<html>

<head>
    <title>Titulo da Página</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <%-include('../partials/header') %>

        <%vagas.forEach((vaga)=> { %>
            <%=vaga.titulo_vaga %> <br />
            <%=vaga.quantidade_vagas %> <br />
            <%=vaga.salario %> <br />
            <%=vaga.regime_contrato %> <br />
            <%=vaga.tipo_trabalho %> <br />
            <%=vaga.localizacao %> <br />
            <%=vaga.descricao_vaga %> <br />
        <% }) %>

    <%-include('../partials/footer') %>
</body>

</html>